/* css made by me with technical help from w3schools.org */

body{
font-family: 'Work Sans', sans-serif;
    margin-top: -2px;
  margin-left: -2px;
  margin-right: -2px;
  overflow: scroll;

}
.headerp{
	color: white; 
	background-image: url(images/earth2.webp); 
	background-position: static; 
	background-color: black; 
	background-size: cover;
	text-shadow: 2px 2px black; 
	background-attachment: sticky;
	  background-color: black;
  text-align: center;
  padding: 20px;
}
.header {
  background-color: #F1F1F1;
  text-align: center;
  padding: 20px;
}
.boxm{
	background-color: #1f1f1f;
	
	
}
/* Style the top navigation bar */
.topnav {
  overflow: hidden;
  background-color: #333;
  position: sticky;
}

/* Style the topnav links */
.topnav a {
  float: left;
  display: block;
  color: #f2f2f2;
  text-align: center;
  padding: 14px 16px;
  text-decoration: none;
  transition: 0.3s;
  
}

/* Change color on hover */
.topnav a:hover {
  background-color: #6bff72;
  color: black;
  padding: 16px 18px;
}

 /* Create three equal columns that float next to each other */
.column {
  float: left;
  width: 33.33%;
  margin: 10px;
}
 /* Create three equal columns that float next to each other */
.columncenter {
  text-align: center
  width: 100%;
  margin: 10px;
}
/* Clear floats after the columns */
.row:after {
  content: "";
  display: table;
  clear: both;
}

/* Responsive layout - makes the three columns stack on top of each other instead of next to each other on smaller screens (600px wide or less) */
@media screen and (max-width: 600px) {
  .column {
    width: 100%;
  }
} 
@keyframes credits {
  0%   {background-color: red; background-image: url(images/youtube.png); background-position: center; background-repeat: no-repeat; background-size: 100px 100px; }
  25%  {background-color: white; background-image: url(images/facebook.png); background-position: center; background-repeat: no-repeat; background-size: 100px 100px;}
  50%  {background-color: blue;background-image: url(images/steam.png); background-position: center; background-repeat: no-repeat; background-size: 100px 100px;}
  75% {background-color: white; background-image: url(images/git.png); background-position: center; background-repeat: no-repeat; background-size: 100px 100px;}
  100%   {background-color: red; background-image: url(images/youtube.png); background-position: center; background-repeat: no-repeat; background-size: 100px 100px;}
}
.divc {
  width: 100px;
  height: 100px;
  background-color: red;
  animation-name: credits;
  animation-duration: 10s;
  animation-iteration-count: infinite;
  border-radius: 5px;
  transition: 0.3s;
  border: 2px solid black;
}	
.divc:hover {
	width: 300px;
	text-align: right;
	
	
}